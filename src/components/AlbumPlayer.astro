---
import { sitePath } from '../lib/url';

/**
 * The album's one player: cover, transport, a seek bar, the line that says what is on, and
 * the tracklist itself. One component, one border, the way an album player looks.
 *
 * From the status line down this is the same panel ScreeningPlayer.astro wears, and the same
 * engine drives both: the shared chrome is in global.css and the behaviour is in
 * src/scripts/media-queue.ts, which src/scripts/audio-queue.ts hands eleven attribute names
 * and four Hebrew lines. What is written here is what a record player has and a screening
 * room does not — the cover, and the grid it sits at the head of.
 *
 * The tracklist is not written here. ItemRows renders exactly one <ul class="item-rows">,
 * and that script moves the list into the empty [data-album-queue] slot below once this
 * panel is on screen and wired. That is deliberate: the rows carry the per-track view and
 * download links and the numbering, and a second copy written here would either lose them or
 * double a page of 169 tracks.
 *
 * Served hidden and revealed only by that script. Nothing in here works without it, which is
 * why the list keeps its own <audio controls> per row until the panel is live — with the
 * script absent the list simply stays where the server put it and the page is what it always
 * was. The `hidden` attribute is load-bearing: global.css carries
 * `[hidden] { display: none !important }` because a scoped rule here would otherwise tie
 * with the UA sheet and show a dead player to a visitor with no JavaScript.
 *
 * The catalog has no length for any of the 169 tracks — Drive only reports duration for
 * video — so the clocks and the bar's range open unknown and are filled in from the audio
 * element the first time a track is actually loaded. Nothing here is allowed to fetch a
 * byte before someone presses play.
 */

interface Props {
  /** Names the album's single player, the same label the list of tracks carries. */
  labelHe: string;
  /** The release these tracks came out on, shown when it has no cover to show instead. */
  titleHe?: string;
  /** Catalog-relative cover path, or null for the 37 releases that were never scanned. */
  coverPath?: string | null;
  /** What the panel is cued to before the script has run a line. */
  firstTrackNameHe: string;
  /** How many tracks the playlist holds, which the line above it says out loud. */
  trackCount: number;
}

const { labelHe, titleHe, coverPath = null, firstTrackNameHe, trackCount } = Astro.props;
---

<div class="album-player" data-media-panel data-album-player hidden>
  <div class="player-art mat">
    {
      coverPath ? (
        <img src={sitePath(coverPath)} alt={titleHe ? `עטיפת ${titleHe}` : ''} loading="lazy" decoding="async" />
      ) : (
        /* The archive's usual state, not its exception: no scan, so the dither carries the
           frame and the title is the artwork. Hidden from assistive tech because the page
           already says the release name in its own heading. */
        <div class="release-placeholder dither" aria-hidden="true">
          <strong>{titleHe ?? 'גיליוטין'}</strong>
        </div>
      )
    }
  </div>

  <div class="player-body">
    <p class="player-now" role="status">
      {/* Cued, not playing: the script swaps this the first time the album actually starts,
          so the line never claims a track is running before one is. This is also the only
          live region on the page, which is how the album moving on by itself — a change no
          control made — reaches a screen reader at all. */}
      <span data-album-now-label>מוכן לנגן:</span>{' '}
      <bdi dir="auto" data-album-now-name>{firstTrackNameHe}</bdi>
    </p>

    {/* One LTR instrument inside an RTL page, the same call .mono makes for filenames and
        sizes: a position inside a duration is a number line, and its two clocks read
        0:00 on the left and the total on the right whatever the page direction is. */}
    <div class="player-controls">
      <div class="player-seek">
        <span class="mono player-clock" data-album-elapsed>0:00</span>
        <input
          class="player-range"
          type="range"
          min="0"
          max="0"
          step="1"
          value="0"
          aria-label="איפה אנחנו בשיר"
          aria-valuetext="0:00"
          aria-disabled="true"
          data-album-seek
        />
        <span class="mono player-clock" data-album-total>--:--</span>
      </div>

      <div class="player-transport">
        <button class="player-button" type="button" aria-label="השיר הקודם" aria-disabled="true" data-album-prev>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M7 5h2.5v14H7zM19 5v14l-8.5-7z"></path>
          </svg>
        </button>
        <button
          class="player-button player-toggle"
          type="button"
          aria-label="נגן"
          data-album-toggle
        >
          <svg class="icon-play" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 5v14l11-7z"></path>
          </svg>
          <svg class="icon-pause" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
          </svg>
        </button>
        <button class="player-button" type="button" aria-label="השיר הבא" data-album-next>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M14.5 5H17v14h-2.5zM5 5l8.5 7L5 19z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* The playlist's own plate, spanning the panel under the art and the transport. It is
      served empty and stays empty without JavaScript: the script moves the rendered
      <ul class="item-rows"> in here, so there is only ever one copy of the tracklist and
      every per-track link on it survives the move untouched. */}
  <div class="player-list">
    <p class="player-list-note">
      אז יש פה {trackCount} שירים. לחצו על אחד, או תנו לזה לרוץ מהתחלה!
    </p>
    {/* Its own scrollport: the biggest album here has 36 tracks, and a playlist that long
        has to run inside the player instead of dragging it down the page. */}
    <div class="player-queue" data-album-queue></div>
  </div>

  {/* No controls: the panel around it is the control. preload="none" is what keeps a page of
      169 tracks free to open. Chrome's UA sheet gives audio:not([controls]) display:none, so
      this is not a grid item and never takes a cell. */}
  <audio class="album-audio" data-album-audio preload="none" aria-label={labelHe}></audio>
</div>

<style>
  /*
   * Only what belongs to this player and to no other. The status line, the transport, the bar
   * and the queue plate are the panel both players wear, and they are in global.css under
   * that heading — this component and ScreeningPlayer.astro differ in the grid they lay out
   * on and in the frame at the head of it, which is a cover here and a 320px stage there.
   */

  /* The art grows with the panel: at a phone width it is a stamp beside the controls, and on
     a wide page it is the piece of art the album is, which is what the archive is for. */
  .album-player {
    display: grid;
    grid-template-columns: clamp(4rem, 12vw, 8rem) minmax(0, 1fr);
    gap: clamp(0.7rem, 2vw, 1.2rem);
    align-items: center;
    /* The card is as wide as a player needs and no wider. Left to span the whole column it
       stretched the bar into a rule and left a hole beside the controls. The tracklist sits
       inside this width too — a playlist row is a name and two links, not a table. */
    max-width: 46rem;
    margin-bottom: 0.9rem;
    padding: clamp(0.7rem, 2vw, 1rem);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--accent) 8%, var(--raise));
  }

  /* 3:4, matching the tile and the room hero. A curated cover IS 3:4, so a 4:5 frame matted
     the same artwork with two side bars nobody chose — piposh-1 is the case that exposes it,
     being the one game whose page and whose album both show a cover. */
  .player-art {
    aspect-ratio: 3 / 4;
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-s);
  }

  .player-art img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* The placeholder is sized for a release tile; at this size its display face would swallow
     the box, so only the type comes down. */
  .player-art .release-placeholder {
    padding: 0.4rem;
  }

  .player-art .release-placeholder strong {
    font-size: var(--t-2xs);
    line-height: 1.2;
  }

  .player-art .release-placeholder::before {
    inset: 0.3rem;
  }

  @media (max-width: 30rem) {
    .album-player {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 0.7rem;
      padding: 0.7rem;
    }
  }
</style>
