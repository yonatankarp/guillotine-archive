---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { catalog } from '../lib/catalog';
import { searchFilterValues } from '../catalog/search';
import { sitePath } from '../lib/url';
import { itemKindLabel } from './release-view';
import type { ItemKind } from '../catalog/types';

const filterValues = searchFilterValues(catalog);

const SEARCH_INDEX_PATH = 'data/search-index.json';

/**
 * The index is 2.5 MB at a URL that never changes while its contents change on every sync, and
 * Pages serves it with a `max-age=600` that cannot be configured. A visitor who searched
 * before a sync therefore searches the old index for ten minutes afterwards and is quietly
 * told the new releases do not exist. A content hash in the query string ends that: the URL
 * moves exactly when the bytes move, and not otherwise.
 *
 * A query string rather than a hashed filename, and for the reason `astro.config.ts` already
 * documents for the stylesheet: renaming a file under `max-age=600` means cached HTML asks for
 * a name that has been deleted, and that 404 was reported in the wild. Here the file keeps its
 * name, so a stale page asking for `?v=<old>` still gets served the current index — slightly
 * newer data than the page expected, never a miss. It also needs nothing from the sync
 * pipeline, so it works on the tree as committed rather than after the next Drive run.
 *
 * The hash is of the committed artifact, which is what ships: both workflows build after the
 * sync that writes it, never before.
 */
function searchIndexUrl(): string {
  try {
    const index = readFileSync(join(process.cwd(), 'public', SEARCH_INDEX_PATH));
    return `${SEARCH_INDEX_PATH}?v=${createHash('sha256').update(index).digest('hex').slice(0, 12)}`;
  } catch {
    // Unhashed is the behaviour this replaces, so an unreadable artifact costs the
    // cache-busting and nothing else. `search-client.ts` still fetches a URL that resolves.
    return SEARCH_INDEX_PATH;
  }
}

/* The kinds worth filtering by. game-data and noise are engine droppings: real, catalogued,
   and not something anyone browses for. */
const kindFilters: ItemKind[] = [
  'build',
  'track',
  'sound',
  'video',
  'scan',
  'booklet-page',
  'comic-page',
  'press-page',
  'sprite',
  'cover',
  'document',
];
---

<section
  class="archive-search"
  data-search-root
  data-index-url={sitePath(searchIndexUrl())}
  data-base-url={import.meta.env.BASE_URL}
  aria-busy="false"
>
  <form
    class="search-form"
    role="search"
    aria-label="חיפוש בארכיון"
    action={sitePath('search/')}
    method="get"
    data-search-form
  >
    <div class="query-field">
      <label for="archive-search">נו, מה מחפשים?</label>
      <p id="archive-search-help">החיפוש מבין עברית בלבד! הרבה שמות קבצים פה באנגלית, מוצגים בדיוק כמו שנשמרו, אבל אל תנסו להקליד אותם. זה לא יעבוד.</p>
      <div class="query-controls">
        <input
          id="archive-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="למשל: פיפוש 1"
          aria-describedby="archive-search-help"
          data-search-input
        />
        <button type="submit">חיפוש</button>
      </div>
    </div>
    <div class="filter-field">
      <label for="category-filter">איזה מדף</label>
      <select id="category-filter" name="category" data-search-category>
        <option value="">הכול</option>
        {filterValues.map((value) => <option value={value}>{value}</option>)}
      </select>
    </div>
    <div class="filter-field">
      <label for="kind-filter">איזה סוג קובץ</label>
      <select id="kind-filter" name="kind" data-search-kind>
        <option value="">הכול</option>
        {kindFilters.map((kind) => <option value={kind}>{itemKindLabel(kind)}</option>)}
      </select>
    </div>
  </form>

  {/* tabindex="-1" so the loading state can park focus here when it disables the control the
      user was in. Not reachable by tab; only script moves focus to it. */}
  <p class="search-status" role="status" aria-live="polite" tabindex="-1" data-search-status>
    נו? כתבו משהו בעברית. אנחנו לא הולכים לנחש בשבילכם.
  </p>
  <p class="search-fallback" data-search-fallback hidden>
    נסו לטעון את הדף מחדש, בדרך כלל זה עוזר. בינתיים <a href={sitePath('archive/')}>כל הארכיון</a> פתוח.
  </p>
  <noscript>
    <p class="search-fallback">
      החיפוש צריך JavaScript, ואין לנו תירוץ יותר טוב. <a href={sitePath('archive/')}>כל הארכיון</a> פתוח כרגיל.
    </p>
  </noscript>
  <ol class="search-results" data-search-results></ol>
</section>

<script>
  import '../scripts/search-client';
</script>
