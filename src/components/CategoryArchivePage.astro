---
import type { CatalogItem } from '../catalog/types';
import FileList from './FileList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatFileCount } from '../lib/archive';
import { sitePath } from '../lib/url';

interface Props {
  category: string;
  slug: string;
  items: CatalogItem[];
  page: number;
  pageCount: number;
  itemCount: number;
}

const { category, slug, items, page, pageCount, itemCount } = Astro.props;
const itemCountLabel = formatFileCount(itemCount);
const archivePagePath = (pageNumber: number) =>
  sitePath(
    pageNumber === 1
      ? `archive/${slug}/`
      : `archive/${slug}/page/${pageNumber}/`,
  );
---

<BaseLayout title={`${category} — ארכיון גיליוטין`}>
  <header class="category-intro">
    <a class="back-link" href={sitePath('archive/')}>חזרה לכל הארכיון</a>
    <h1>{category}</h1>
    <p>
      {itemCountLabel} בקטגוריה הזאת. השמות והנתיבים מוצגים בדיוק כפי שנשמרו בקטלוג.
      {pageCount > 1 && <> עמוד {page} מתוך {pageCount}.</>}
    </p>
  </header>

  <FileList items={items} showCollectionLinks />

  {
    pageCount > 1 && (
      <nav class="pagination" aria-label="עמודי קטגוריה">
        {page > 1 ? (
          <a
            class="previous-page"
            href={archivePagePath(page - 1)}
            aria-label={`לעמוד הקודם, עמוד ${page - 1}`}
          >
            העמוד הקודם
          </a>
        ) : null}
        <span class="page-status" aria-current="page">עמוד {page} מתוך {pageCount}</span>
        {page < pageCount ? (
          <a
            class="next-page"
            href={archivePagePath(page + 1)}
            aria-label={`לעמוד הבא, עמוד ${page + 1}`}
          >
            העמוד הבא
          </a>
        ) : null}
      </nav>
    )
  }
</BaseLayout>

<style>
  .category-intro {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding-bottom: 1.2rem;
    border-bottom: var(--line) solid var(--ink);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.82rem;
    font-weight: 850;
    text-underline-offset: 0.25rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.7rem, 8vw, 6rem);
    letter-spacing: -0.065em;
    line-height: 0.92;
    overflow-wrap: anywhere;
  }

  .category-intro p {
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .pagination {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: var(--line) solid var(--ink);
  }

  .pagination a {
    width: fit-content;
    max-width: 100%;
    padding: 0.55rem 0.8rem;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--lime);
    font-size: 0.82rem;
    font-weight: 850;
    text-align: center;
    text-decoration: none;
  }

  .previous-page {
    grid-column: 1;
  }

  .next-page {
    grid-column: 3;
    justify-self: end;
  }

  .page-status {
    grid-column: 2;
    font-size: 0.82rem;
    font-weight: 850;
    text-align: center;
  }

  @media (max-width: 480px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }

    .page-status {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .previous-page {
      grid-column: 1;
    }

    .next-page {
      grid-column: 2;
    }
  }
</style>
