---
import type { CatalogItem } from '../catalog/types';
import FileList from './FileList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatFileCount } from '../lib/archive';
import { sitePath } from '../lib/url';

interface Props {
  category: string;
  slug: string;
  items: CatalogItem[];
  page: number;
  pageCount: number;
  itemCount: number;
}

const { category, slug, items, page, pageCount, itemCount } = Astro.props;
const itemCountLabel = formatFileCount(itemCount);
const archivePagePath = (pageNumber: number) =>
  sitePath(
    pageNumber === 1
      ? `archive/${slug}/`
      : `archive/${slug}/page/${pageNumber}/`,
  );

/* One category can run to 17 pages, so the page number has to reach the tab, the history
   entry and the search result — everywhere the <h1> does not. Page 1 keeps the bare title
   because that is the page the category is known by. Each page stays its own canonical:
   pointing them all at page 1 would hide the very items the numbering exists to separate. */
const pageSuffix = page === 1 ? '' : ` — עמוד ${page}`;
const pageDescriptionSuffix = page === 1 ? '' : ` עמוד ${page} מתוך ${pageCount}.`;
---

<BaseLayout
  title={`${category}${pageSuffix} — ארכיון גיליוטין`}
  description={`${category} בארכיון גיליוטין: ${itemCountLabel}, בשמות ובנתיבים שבהם נשמרו.${pageDescriptionSuffix}`}
>
  <header class="category-intro">
    <a class="back-link" href={sitePath('archive/')}>חזרה לכל המדפים</a>
    <h1>{category}</h1>
    <p>
      {itemCountLabel} בקטגוריה הזאת. השמות והנתיבים מוצגים בדיוק כמו שנשמרו, כולל שגיאות
      הכתיב — הן חלק מהארכיון כמו כל השאר, ולא נתחיל לתקן עכשיו.
      {pageCount > 1 && <> עמוד {page} מתוך {pageCount}.</>}
    </p>
  </header>

  <FileList items={items} showCollectionLinks />

  {
    pageCount > 1 && (
      <nav class="pagination" aria-label="עמודי קטגוריה">
        {page > 1 ? (
          <a
            class="previous-page"
            href={archivePagePath(page - 1)}
            aria-label={`לעמוד הקודם, עמוד ${page - 1}`}
          >
            העמוד הקודם
          </a>
        ) : null}
        <span class="page-status" aria-current="page">עמוד {page} מתוך {pageCount}</span>
        {page < pageCount ? (
          <a
            class="next-page"
            href={archivePagePath(page + 1)}
            aria-label={`לעמוד הבא, עמוד ${page + 1}`}
          >
            העמוד הבא
          </a>
        ) : null}
      </nav>
    )
  }
</BaseLayout>

