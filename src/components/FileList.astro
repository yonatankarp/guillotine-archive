---
import type { CatalogItem } from '../catalog/types';
import {
  driveActions,
  fileTypeLabel,
  formatFileSize,
  officialCollectionLinks,
} from '../lib/archive';
import { sitePath } from '../lib/url';

interface Props {
  items: CatalogItem[];
  heading?: string;
  showCollectionLinks?: boolean;
}

const { items, heading, showCollectionLinks = false } = Astro.props;

/*
 * The shelf a file sits on, which is its path with the last segment taken off. The row above
 * already prints that segment as the file's name, so printing the whole path under it said the
 * filename twice — 94 times over on /archive/games/. Nothing is truncated and nothing is
 * abbreviated: the same characters are still on the page, the name once and the folders once.
 * The trailing separator goes with it, because a slash is bidi-neutral and would be flung to
 * the far end of an RTL-inferred line rather than sitting where a path ends.
 */
function archiveFolder(path: string): string | null {
  const lastSeparator = path.lastIndexOf('/');
  return lastSeparator > 0 ? path.slice(0, lastSeparator) : null;
}
---

{heading && <h2>{heading}</h2>}
{
  items.length === 0 ? (
    <p class="empty-files">אין פה אף קובץ מקוטלג. מדור שלם, ריק, ואין לנו הסבר.</p>
  ) : (
    /* list-style: none makes WebKit drop the list role, so VoiceOver never announces
       "list, 94 items" on a shelf whose whole point is how much is on it. */
    <ul class="file-list" role="list" aria-label={heading ?? 'קבצים בארכיון'}>
      {items.map((item) => {
        const actions = driveActions(item);
        const officialCollections = officialCollectionLinks(item);
        const folder = archiveFolder(item.path);

        return (
          <li>
            <div class="file-copy">
              <strong><bdi dir="auto">{item.name}</bdi></strong>
              <p class="file-meta">
                <span class="mono"><span class="visually-hidden">סוג קובץ: </span>{fileTypeLabel(item)}</span>
                <span class="mono"><span class="visually-hidden">גודל קובץ: </span>{formatFileSize(item.size)}</span>
              </p>
              {folder !== null && (
                <p class="file-path">
                  <span class="visually-hidden">תיקייה בארכיון: </span>
                  <bdi dir="auto">{folder}</bdi>
                </p>
              )}
              {showCollectionLinks && officialCollections.length > 0 && (
                <ul class="collection-links" role="list" aria-label="שיוך למהדורות רשמיות">
                  {officialCollections.map((link) => (
                    <li>
                      <a href={sitePath(`release/${link.slug}/`)}>
                        שייך למהדורה הרשמית: {link.titleHe}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {actions.length > 0 && (
              <div class="file-actions">
                {actions.map((action) => (
                  <a
                    class:list={['file-action', action.kind]}
                    href={action.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={action.label}
                  >
                    {action.kind === 'view' ? 'צפייה' : 'הורדה'}
                  </a>
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )
}

