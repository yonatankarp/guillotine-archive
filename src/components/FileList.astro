---
import type { CatalogItem } from '../catalog/types';
import {
  driveActions,
  fileTypeLabel,
  formatFileSize,
  officialCollectionLinks,
} from '../lib/archive';
import { sitePath } from '../lib/url';

interface Props {
  items: CatalogItem[];
  heading?: string;
  showCollectionLinks?: boolean;
}

const { items, heading, showCollectionLinks = false } = Astro.props;
---

{heading && <h2>{heading}</h2>}
{
  items.length === 0 ? (
    <p class="empty-files">אין כרגע קבצים מקוטלגים במדור הזה.</p>
  ) : (
    <ul class="file-list" aria-label={heading ?? 'קבצים בארכיון'}>
      {items.map((item) => {
        const actions = driveActions(item);
        const officialCollections = officialCollectionLinks(item);

        return (
          <li>
            <div class="file-copy">
              <strong><bdi dir="auto">{item.name}</bdi></strong>
              <p class="file-meta">
                <span><span class="visually-hidden">סוג קובץ: </span>{fileTypeLabel(item)}</span>
                <span><span class="visually-hidden">גודל קובץ: </span>{formatFileSize(item.size)}</span>
              </p>
              <p class="file-path">
                <span class="visually-hidden">נתיב בארכיון: </span>
                <bdi dir="auto">{item.path}</bdi>
              </p>
              {showCollectionLinks && officialCollections.length > 0 && (
                <ul class="collection-links" aria-label="שיוך למהדורות רשמיות">
                  {officialCollections.map((link) => (
                    <li>
                      <a href={sitePath(`games/${link.slug}/`)}>
                        חלק מהמהדורה הרשמית: {link.titleHe}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {actions.length > 0 && (
              <div class="file-actions" aria-label={`פעולות עבור ${item.name}`}>
                {actions.map((action) => (
                  <a
                    class:list={['file-action', action.kind]}
                    href={action.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={action.label}
                  >
                    {action.kind === 'view' ? 'צפייה ב־Drive' : 'הורדה'}
                  </a>
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )
}

