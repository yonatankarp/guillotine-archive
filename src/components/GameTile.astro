---
import type { CatalogCollection } from '../catalog/types';
import { catalogItemCountLabel } from '../lib/homepage';
import { sitePath } from '../lib/url';

interface Props {
  game: CatalogCollection;
  position: number;
  summary: string;
}

const { game, position, summary } = Astro.props;
const officialCount = game.itemIds.length;
const archiveNumber = String(position + 1).padStart(2, '0');
---

<a
  class="game-tile"
  href={sitePath(`games/${game.slug}/`)}
  aria-label={`${game.titleHe} — לדף המשחק`}
  data-testid="game-tile"
  data-game={game.slug}
>
  <div class="cover-frame">
    {
      game.coverUrl ? (
        <img src={sitePath(game.coverUrl)} alt={`עטיפת ${game.titleHe}`} loading="lazy" />
      ) : (
        <div class="cover-fallback" data-cover-kind="fallback" aria-hidden="true">
          <span class="cover-series">תיק משחק / {archiveNumber}</span>
          <strong>{game.titleHe}</strong>
          <span class="cover-note">העטיפה בדרכה מן הארכיון</span>
          <span class="cover-seal">גיליוטין</span>
        </div>
      )
    }
  </div>
  <div class="tile-copy">
    <div class="tile-heading">
      <h2>{game.titleHe}</h2>
      {game.year && <span class="game-year">{game.year}</span>}
    </div>
    <p>{summary}</p>
    <span class:list={['fact-badge', { empty: officialCount === 0 }]}>
      {catalogItemCountLabel(officialCount)}
    </span>
  </div>
</a>
