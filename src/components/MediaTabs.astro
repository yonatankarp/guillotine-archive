---
import type { ReleaseType } from '../catalog/types';
import { releases } from '../lib/releases';
import { sitePath } from '../lib/url';
import { releaseTypeLabel } from './release-view';

/**
 * The home page is the six games and nothing else. Everything else in the
 * archive lives behind one of these, because putting 36 further releases under
 * the games is what buried them in the first place.
 *
 * Each tab is a real pre-rendered page with its own URL rather than a client-side
 * filter, so it is linkable and works without JavaScript.
 */
interface Props {
  /**
   * The type this page is showing, or 'game' on the home page. Pages that are not a
   * single type — a subject, a year, the whole list — pass null, because marking a tab
   * current there told a screen reader the visitor was somewhere they are not.
   */
  active: ReleaseType | null;
}

const { active } = Astro.props;

const countByType = new Map<ReleaseType, number>();
for (const release of releases) {
  countByType.set(release.type, (countByType.get(release.type) ?? 0) + 1);
}

/** Games first because they are what people came for; the rest in a fixed order. */
const ORDER: readonly ReleaseType[] = [
  'game',
  'audio-cd',
  'video',
  'press',
  'fan-disc',
  'fan-game',
  'demo',
  'other',
];

const tabs = ORDER.filter((type) => (countByType.get(type) ?? 0) > 0).map((type) => ({
  type,
  labelHe: type === 'game' ? 'המשחקים' : releaseTypeLabel(type),
  count: countByType.get(type) ?? 0,
  href: type === 'game' ? sitePath() : sitePath(`browse/type/${type}/`),
}));

/**
 * A tab is the current page only when it is the current page. The games tab is the one
 * that points home rather than at a filter, and /browse/type/game/ lists the same six
 * releases — so on that route the type matched, the tab announced aria-current="page",
 * and clicking it navigated away. The type alone cannot see that two routes show one
 * type; the href against the URL being rendered can, and it needs no second route.
 */
const withSlash = (path: string): string => (path.endsWith('/') ? path : `${path}/`);
/* Both sides are compared without the base path in front of them. sitePath() always puts
   it there and the rendered URL may or may not, depending on how the site is built, and a
   deploy under /guillotine-archive/ is not the place to discover which. */
const stripBase = (path: string): string => {
  const base = withSlash(import.meta.env.BASE_URL);
  const full = withSlash(path);
  return full.startsWith(base) ? `/${full.slice(base.length)}` : full;
};
const currentPath = stripBase(Astro.url.pathname);
---

<nav class="media-tabs" aria-label="מדורי הארכיון">
  {/* WebKit drops the list role from a list styled list-style: none, and the count of
      sections is the point of the strip. */}
  <ul role="list">
    {
      tabs.map((tab) => (
        <li>
          <a
            href={tab.href}
            aria-current={
              tab.type === active && stripBase(tab.href) === currentPath ? 'page' : undefined
            }
          >
            {tab.labelHe} <span class="mono">{tab.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
