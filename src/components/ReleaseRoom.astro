---
import type { CatalogItem, Release } from '../catalog/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatFileCount, formatFileSize } from '../lib/archive';
import { itemById } from '../lib/catalog';
import { categorySlug, sitePath } from '../lib/url';
import ItemRows from './ItemRows.astro';
import MediaGallery from './MediaGallery.astro';
import { audioUrl, hasThumbs, videoUrl } from './derivative';
import { coverRenditions } from './cover-sources';
import {
  creditedWorks,
  itemCountsByKind,
  itemKindLabel,
  coverlessArt,
  releaseAccent,
  releaseCoverPath,
  releaseBundle,
  releaseItems,
  releaseSections,
  releaseStandInCover,
  releaseTypeLabel,
  scrawlSize,
  sharedMirrorCategory,
} from './release-view';

interface Props {
  release: Release;
  /** Site-relative, forwarded to BaseLayout. Only for a route that aliases another one. */
  canonical?: string;
}

const { release, canonical } = Astro.props;
const accent = releaseAccent(release);
/* Ring geometry for the mat behind a release with no cover; see coverlessArt(). */
const art = coverlessArt(release.slug);
const items = releaseItems(release, itemById);
const cover = releaseCoverPath(release);
/* An image the release already owns, standing in for the cover it never had. Only two rules
   feed this and both read `kind` — see releaseStandInCover. */
const standIn = cover === null ? releaseStandInCover(items) : null;
/* One object, so a branch that has a path also has the box to reserve for it. A curated cover
   is cropped to 720x960; a stand-in keeps whatever shape it was scanned at. */
const heroImage: { path: string; width: number; height: number } | null = cover
  ? { path: cover, width: 720, height: 960 }
  : standIn;
/* Dropped entirely when the narrower rendition is not on disk, so the hero renders today's
   single-file <img> before the sync that first writes the tiers, and both after it. */
const coverSources = cover ? coverRenditions(cover) : (standIn?.renditions ?? []);
const coverSrcset =
  coverSources.length > 0
    ? coverSources.map(({ path, width }) => `${sitePath(path)} ${width}w`).join(', ')
    : undefined;
/* `.room-cover img` is width: 100%, so the hero has none of the tile's intrinsic-size hazard
   and this only has to be close. The cover column is minmax(13rem, 0.5fr) of a padded 1180px
   hero, which tops out near 356px; under 900px the hero stacks and the column is capped at
   16rem by `.room-cover`. */
const COVER_SIZES = '(max-width: 900px) 16rem, 23rem';
/* Decorative when it is a stand-in: the h1 beside it names the release, and the first page of
   a comic is not "עטיפת קומיקס". Only a real cover is announced. */
const heroAlt = cover ? `עטיפת ${release.titleHe}` : '';
const sections = releaseSections(items);
const bundle = releaseBundle(items);

/* One note per section, and only while nothing in it can actually play. */
const hasAudioHere = (of: readonly CatalogItem[]) =>
  of.some((item) => item.derivatives?.audio !== undefined);
const credits = creditedWorks(items);
const kindCounts = itemCountsByKind(items);
const subjectSlug = release.subjectSlug;

/* The Drive mirror is the only paginated view of a release this large, so a capped section
   points there rather than growing without limit. Each link is derived from the items it
   stands for, because a release can be filed across several shelves. */
const mirrorHref = (of: readonly CatalogItem[]) => {
  const category = sharedMirrorCategory(of);
  return category ? sitePath(`archive/${categorySlug(category)}/`) : sitePath('archive/');
};

/* The shelf a release was filed on is the one fact the hero does not already print — the
   back link and the facts line both carry the type. A release assembled across several
   shelves has no single answer, and "אחר" names nothing; both cases drop the line and let
   the h1 lead. 35 of the 42 releases name a shelf. */
const filedShelf = sharedMirrorCategory(items);
const shelf = filedShelf === 'אחר' ? null : filedShelf;

const facts = [
  releaseTypeLabel(release.type),
  release.formatHe,
  release.year?.toString(),
  formatFileCount(items.length),
].filter((fact): fact is string => fact !== undefined);
---

<BaseLayout
  title={`${release.titleHe} — ארכיון גיליוטין`}
  image={cover ?? undefined}
  canonical={canonical}
>
  <article class="release-room" style={`--accent: ${accent};`}>
    <header class="room-hero">
      <div class="room-hero-copy">
        <a class="back-link" href={sitePath(`browse/type/${release.type}/`)}>
          עוד מהסוג הזה — {releaseTypeLabel(release.type)}
        </a>
        {shelf && <p class="eyebrow">נשמר במדף {shelf}</p>}
        <h1>{release.titleHe}</h1>
        <p class="room-facts">{facts.join(' · ')}</p>
        {
          subjectSlug && (
            <p class="room-subject">
              <a href={sitePath(`browse/subject/${subjectSlug}/`)}>כל מה שיצא סביב המשחק הזה</a>
            </p>
          )
        }
      </div>
      <div class="room-cover mat">
        {
          heroImage ? (
            <img
              src={sitePath(heroImage.path)}
              srcset={coverSrcset}
              sizes={coverSrcset === undefined ? undefined : COVER_SIZES}
              alt={heroAlt}
              width={heroImage.width}
              height={heroImage.height}
            />
          ) : (
            /* The same object as the tile at a different size: the mat is the burned CD-R and
               the title is what was written on it. Beside a --t-4xl h1 the scrawl lands at
               about 0.6x its size, so the hero still reads h1 first. */
            <div
              class="release-placeholder dither"
              aria-hidden="true"
              style={`--scrawl: ${scrawlSize(release.titleHe)}cqi; --art-x: ${art.x}%; --art-y: ${art.y}%; --art-step: ${art.step}px;`}
            >
              <strong>{release.titleHe}</strong>
            </div>
          )
        }
      </div>
    </header>

    {
      sections.map((section) => (
        <section class="room-section" aria-labelledby={`section-${section.id}`}>
          <h2 id={`section-${section.id}`}>{section.headingHe}</h2>
          {section.id === 'music' && !hasAudioHere(section.items) && (
            <p class="room-note">
              עוד אין פה גרסה שמתנגנת. בינתיים כל רצועה נפתחת בלשונית חדשה.
            </p>
          )}
          {section.id === 'gallery' && hasThumbs(section.items) ? (
            <MediaGallery
              items={section.items}
              labelHe={`${section.headingHe} — ${release.titleHe}`}
              releaseTitleHe={release.titleHe}
            />
          ) : (
            <ItemRows
              items={section.items}
              labelHe={`${section.headingHe} — ${release.titleHe}`}
              releaseTitleHe={release.titleHe}
              coverPath={cover}
              showText={section.id === 'documents'}
              showMediaNote={section.id !== 'music'}
              mediaSrc={
                section.id === 'music' ? audioUrl : section.id === 'video' ? videoUrl : undefined
              }
            />
          )}
          {section.hiddenCount > 0 && (
            <p class="room-more">
              יש פה עוד {section.hiddenCount} קבצים, ולא הצגנו אותם כדי לא למשוך את העמוד עד מחר.{' '}
              <a href={mirrorHref(section.items)}>לרשימה המלאה במדף</a>
            </p>
          )}
        </section>
      ))
    }

    {
      bundle.length > 0 && (
        <section class="room-section" aria-labelledby="section-bundle">
          <h2 id="section-bundle">מה שהמשחק פיזר על הדיסק</h2>
          <p class="room-note">
            אלה הקבצים שנוצרו כשהמשחק הותקן, לא משהו שמישהו תייק בכוונה: הצלילים של המנוע,
            תמונות של דמויות, קבצי נתונים. אנחנו סופרים אותם ולא מציגים אחד־אחד — כי ערימה של
            קבצי עזר זו לא תערוכה, זו עבודה.
          </p>
          {/* WebKit drops the list role when list-style is none, and then VoiceOver never
              announces how many rows there are. */}
          <ul class="bundle-list" role="list">
            {bundle.map(({ kind, count, bytes }) => (
              <li>
                <strong>{itemKindLabel(kind)}</strong>
                <span class="mono">{count}</span>
                <span class="mono">{formatFileSize(bytes)}</span>
              </li>
            ))}
          </ul>
          <p class="room-more">
            <a href={mirrorHref(items)}>לרשימה המלאה במדף הארכיון</a>
          </p>
        </section>
      )
    }

    {
      credits.length > 0 && (
        <section class="room-section" aria-labelledby="section-credits">
          <h2 id="section-credits">מי בכלל עשה את זה</h2>
          <p class="room-note">
            את המשחקים האלה תייקו לפי היוצר, ולכן זה המקום היחיד בכל הארכיון שבו הקרדיט שרד.
            בכל השאר הוא הלך לאיבוד.
          </p>
          <ul class="credit-list" role="list">
            {credits.map(({ author, items: works }) => (
              <li>
                <strong>{author}</strong>
                <span class="mono">{works.length}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="room-section" aria-labelledby="section-all">
      <h2 id="section-all">כמה יש מכל דבר</h2>
      <details class="all-files">
        <summary>מה יש כאן, לפי סוג</summary>
        <ul class="kind-counts" role="list">
          {
            kindCounts.map(([kind, count]) => (
              <li>
                <span>{itemKindLabel(kind)}</span>
                <span class="mono">{count}</span>
              </li>
            ))
          }
        </ul>
        <p class="room-more">
          <a href={mirrorHref(items)}>לפתיחת המדפים עצמם</a>
        </p>
      </details>
    </section>
  </article>
</BaseLayout>
