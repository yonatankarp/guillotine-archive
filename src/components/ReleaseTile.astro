---
import type { Release } from '../catalog/types';
import { formatFileCount } from '../lib/archive';
import { itemById } from '../lib/catalog';
import { sitePath } from '../lib/url';
import { coverRenditions } from './cover-sources';
import {
  coverlessArt,
  releaseAccent,
  releaseCoverPath,
  releaseItems,
  releaseStandInCover,
  releaseTypeLabel,
  scrawlSize,
} from './release-view';

interface Props {
  release: Release;
  itemCount: number;
  showSummary?: boolean;
  /** The grid decides: a year is worth printing only where more than one tile has one. */
  showYear?: boolean;
}

const { release, itemCount, showSummary = false, showYear = false } = Astro.props;
const accent = releaseAccent(release);
/* Ring geometry for the mat behind a release with no cover; see coverlessArt(). */
const art = coverlessArt(release.slug);
const cover = releaseCoverPath(release);
/*
 * Only for a release with no cover of its own, so the five curated ones never pay for the
 * itemIds lookup, and the 33 that end at the placeholder pay it once at build time.
 */
const standIn = cover === null ? releaseStandInCover(releaseItems(release, itemById)) : null;
/*
 * One object, so a branch that has a path also has the box to reserve for it and the template
 * cannot emit a src without its dimensions. The ratio is not always 3:4: a curated cover is
 * cropped to 720x960, but a stand-in keeps whatever it was scanned at, and בטשת מואב's is
 * landscape. Naming the wrong one reserves the wrong box and shifts the grid when it lands.
 */
const image: { path: string; width: number; height: number } | null = cover
  ? { path: cover, width: 720, height: 960 }
  : standIn;
/*
 * `undefined` and not '' when there is nothing to choose between, so Astro drops the attribute
 * and the tile emits exactly the <img> it emitted before the tiers existed. A stand-in names
 * the two derivative tiers it already has rather than the cover tiers, which it does not.
 */
const renditions = cover ? coverRenditions(cover) : (standIn?.renditions ?? []);
const srcset =
  renditions.length > 0
    ? renditions.map(({ path, width }) => `${sitePath(path)} ${width}w`).join(', ')
    : undefined;

/*
 * `sizes` has to be an UPPER bound on the box, not an estimate, and this is the part that is
 * easy to get wrong. With w descriptors the browser replaces the image's intrinsic width with
 * whatever `sizes` resolves to, and `.release-cover img` sizes itself from that intrinsic
 * width under `max-width: 100%`. Name a value under the real box and every cover shrinks and
 * starts showing mat around it.
 *
 * main is min(1180px, 100vw - 2rem) and `.release-grid` is auto-fill over 15rem columns, so
 * the widest box is the two-column step, (760 - 20) / 2 = 370px, and every step above it is
 * narrower. 24rem clears that; below 34rem the grid is one column and the box is the column,
 * which is 100vw less the page gutter. Both are over the truth, so the clamp still comes from
 * the container and every tile lays out exactly where it lays out today. Stated in rem rather
 * than px so it tracks `.release-grid`'s own 15rem column if the reader has scaled their text.
 */
const COVER_SIZES = '(max-width: 34rem) 100vw, 24rem';
/*
 * A stand-in is decorative and says so. The heading below already names the release, and
 * calling the first page of a comic "עטיפת קומיקס" describes a thing that is not there; the
 * honest alternative, "the first page of the comic", is what a sighted visitor reads off the
 * tile anyway. Only a real cover is announced.
 */
const alt = cover ? `עטיפת ${release.titleHe}` : '';
const facts = [
  releaseTypeLabel(release.type),
  release.formatHe,
  showYear ? release.year?.toString() : undefined,
].filter((fact): fact is string => fact !== undefined);
---

<li
  class="release-cell"
  data-release-type={release.type}
  data-release-subject={release.subjectSlug ?? ''}
  data-release-year={release.year?.toString() ?? ''}
>
  <a
    class="release-tile"
    style={`--accent: ${accent};`}
    href={sitePath(`release/${release.slug}/`)}
    data-testid="release-tile"
    data-release={release.slug}
  >
    <div class="release-cover mat">
      {
        image ? (
          <img
            src={sitePath(image.path)}
            srcset={srcset}
            sizes={srcset === undefined ? undefined : COVER_SIZES}
            alt={alt}
            loading="lazy"
            width={image.width}
            height={image.height}
          />
        ) : (
          /* The mat is the disc. These are burned CD-Rs with the name written on them in
             marker, and the placeholder is that object rather than an empty frame — the
             .release-placeholder block in global.css carries the argument for why a depicted
             label is not the heading printed twice. --scrawl is per-title because a marker's
             size is a function of how much there is to write, which no CSS length can be. */
          <div
            class="release-placeholder dither"
            aria-hidden="true"
            style={`--scrawl: ${scrawlSize(release.titleHe)}cqi; --art-x: ${art.x}%; --art-y: ${art.y}%; --art-step: ${art.step}px;`}
          >
            <strong>{release.titleHe}</strong>
          </div>
        )
      }
    </div>
    <div class="release-copy">
      {/* A tile sits inside a section that already has its own h2, so it is a level below it. */}
      <h3>{release.titleHe}</h3>
      <p class="release-facts">
        {facts.join(' · ')}
        <span>{formatFileCount(itemCount)}</span>
      </p>
      {showSummary && release.summaryHe && <p class="release-summary">{release.summaryHe}</p>}
    </div>
  </a>
</li>
