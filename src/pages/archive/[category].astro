---
import CategoryArchivePage from '../../components/CategoryArchivePage.astro';
import { paginateArchiveItems } from '../../lib/archive';
import { catalog } from '../../lib/catalog';
import { categoryRoutes } from '../../lib/url';

export function getStaticPaths() {
  return categoryRoutes(catalog.categories).map(({ category, slug }) => ({
    params: { category: slug },
    props: { category, slug },
  }));
}

interface Props {
  category: string;
  slug: string;
}

const { category, slug } = Astro.props;
const categoryItems = catalog.items.filter((item) => item.category === category);
const archivePage = paginateArchiveItems(categoryItems, 1);
---

<CategoryArchivePage category={category} slug={slug} {...archivePage} />
