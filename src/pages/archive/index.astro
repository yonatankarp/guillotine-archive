---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFileCount } from '../../lib/archive';
import { catalog } from '../../lib/catalog';
import { categoryRoutes, sitePath } from '../../lib/url';

const routes = categoryRoutes(catalog.categories);
const itemCountByCategory = new Map<string, number>();
for (const item of catalog.items) {
  itemCountByCategory.set(item.category, (itemCountByCategory.get(item.category) ?? 0) + 1);
}
---

<BaseLayout title="כל הארכיון — ארכיון גיליוטין">
  <header class="page-intro">
    <p class="eyebrow">מדפי הארכיון</p>
    <h1>כל הקבצים לפי מדף</h1>
    <p>המדפים המלאים כפי שהם מופיעים בקטלוג, כולל הקבצים שאף מהדורה לא מציגה בעצמה.</p>
  </header>

  {
    routes.length > 0 ? (
      <ul class="category-grid">
        {routes.map(({ category, slug }) => {
          const count = itemCountByCategory.get(category) ?? 0;
          const countLabel = formatFileCount(count);
          return (
            <li>
              <a
                href={sitePath(`archive/${slug}/`)}
                aria-label={`${category}, ${countLabel}`}
              >
                <strong>{category}</strong>
                <span>{countLabel}</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty-archive">הקטלוג ריק כרגע. אפילו לא מסמך אחד להתלונן עליו.</p>
    )
  }
</BaseLayout>

