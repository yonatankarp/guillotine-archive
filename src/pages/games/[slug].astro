---
import FileList from '../../components/FileList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { CatalogCollection } from '../../catalog/types';
import { groupOfficialItems } from '../../lib/archive';
import { catalog, itemById } from '../../lib/catalog';
import { sitePath } from '../../lib/url';

export function getStaticPaths() {
  return catalog.collections
    .filter((collection) => collection.type === 'game')
    .map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

interface Props {
  collection: CatalogCollection;
}

const { collection } = Astro.props;
const groups = groupOfficialItems(collection, itemById);
---

<BaseLayout title={`${collection.titleHe} — ארכיון גיליוטין`} description={collection.summaryHe}>
  <article class="game-page">
    <header class="game-intro">
      <div class="game-cover">
        {
          collection.coverUrl ? (
            <img src={sitePath(collection.coverUrl)} alt={`עטיפת ${collection.titleHe}`} />
          ) : (
            <div
              class="game-cover-fallback"
              role="img"
              aria-label={`אין כרגע עטיפה זמינה עבור ${collection.titleHe}`}
            >
              <span>תיק משחק</span>
              <strong>{collection.titleHe}</strong>
              <small>עטיפה לא זמינה כרגע</small>
            </div>
          )
        }
      </div>
      <div class="game-copy">
        <p class="eyebrow">תיק רשמי / משחק של גיליוטין</p>
        <h1>{collection.titleHe}</h1>
        <p class="game-description">{collection.descriptionHe ?? collection.summaryHe}</p>
        {collection.year && (
          <p class="game-year"><strong>שנת יציאה:</strong> {collection.year}</p>
        )}
      </div>
    </header>

    <aside class="drive-note" aria-label="מידע על הורדת הקבצים">
      <strong>הקבצים נשארים ב־Google Drive.</strong>
      <span> צפייה והורדה ייפתחו בלשונית חדשה. בקובץ גדול Drive עשוי לבקש אישור נוסף — זו לא תקלה בארכיון.</span>
    </aside>

    {
      groups.length > 0 ? (
        <div class="official-groups" aria-label="חומרים רשמיים">
          {groups.map((group) => (
            <section class="official-group">
              <FileList heading={group.heading} items={group.items} />
            </section>
          ))}
        </div>
      ) : (
        <section class="empty-game" aria-labelledby="empty-game-heading">
          <h2 id="empty-game-heading">התיק מחכה לחומר</h2>
          <p>עדיין אין בתיק הזה קבצים מקוטלגים. הוא נשאר כאן כדי שלא נעמיד פנים שהמשחק לא קיים.</p>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .game-intro {
    display: grid;
    grid-template-columns: minmax(13rem, 19rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .game-cover {
    aspect-ratio: 3 / 4;
    min-width: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: #e5ded0;
    box-shadow: 6px 6px 0 var(--magenta);
  }

  .game-cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: white;
  }

  .game-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.1rem, 3vw, 2rem);
    background:
      linear-gradient(145deg, transparent 0 64%, var(--cyan) 64% 76%, transparent 76%),
      var(--yellow);
  }

  .game-cover-fallback span,
  .game-cover-fallback small {
    width: fit-content;
    padding: 0.25rem 0.45rem;
    border: 1.5px solid var(--ink);
    background: var(--paper-light);
    font-size: 0.68rem;
    font-weight: 900;
  }

  .game-cover-fallback strong {
    max-width: 8ch;
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.07em;
    line-height: 0.88;
  }

  .eyebrow {
    width: fit-content;
    margin: 0 0 0.8rem;
    padding: 0.3rem 0.55rem;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--cyan);
    font-size: 0.72rem;
    font-weight: 900;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 9vw, 7rem);
    letter-spacing: -0.075em;
    line-height: 0.86;
    overflow-wrap: anywhere;
  }

  .game-description {
    max-width: 47rem;
    margin: 1.2rem 0 0;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    line-height: 1.65;
  }

  .game-year {
    margin: 1rem 0 0;
    font-size: 0.86rem;
  }

  .drive-note {
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 1rem 1.2rem;
    border: var(--line) solid var(--ink);
    border-inline-start: 0.5rem solid var(--magenta);
    border-radius: 0.6rem;
    background: var(--paper-light);
    line-height: 1.6;
  }

  .official-groups {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .official-group {
    min-width: 0;
  }

  .empty-game {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: var(--line) dashed var(--ink);
    border-radius: var(--radius);
    background: rgb(255 253 246 / 65%);
  }

  .empty-game h2,
  .empty-game p {
    margin: 0;
  }

  .empty-game p {
    margin-top: 0.65rem;
    line-height: 1.6;
  }

  @media (max-width: 680px) {
    .game-intro {
      grid-template-columns: 1fr;
    }

    .game-cover {
      width: min(100%, 16rem);
    }
  }
</style>
