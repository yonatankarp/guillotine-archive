---
import type { GetStaticPaths } from 'astro';
import ReleaseRoom from '../../components/ReleaseRoom.astro';
import { releases } from '../../lib/releases';

/**
 * The committed search index hard-codes /games/<slug>/ for the six game collections, and the
 * index is a build artifact this page cannot regenerate. So this route stays and renders the
 * same room as /release/<slug>/ rather than becoming a redirect.
 */
export const getStaticPaths = (() =>
  releases
    .filter((release) => release.type === 'game')
    .map((release) => ({
      params: { slug: release.slug },
      props: { release },
    }))) satisfies GetStaticPaths;

const { release } = Astro.props;
---

<ReleaseRoom release={release} />
