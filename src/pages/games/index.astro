---
import ReleaseGrid from '../../components/ReleaseGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releasesOfType } from '../../lib/releases';
import { sitePath } from '../../lib/url';

const gameReleases = releasesOfType('game');
---

<BaseLayout title="המשחקים — ארכיון גיליוטין">
  <header class="page-intro">
    <p class="eyebrow">סוג של דבר</p>
    <h1>המשחקים</h1>
    <p class="lead">
      אלה {gameReleases.length} המשחקים שבאמת יצאו. כל השאר, כולל הדמואים ודיסקי המעריצים,
      מחכה <a href={sitePath()}>ברשימת המהדורות</a>.
    </p>
  </header>

  <section aria-labelledby="games-heading">
    <h2 class="visually-hidden" id="games-heading">מהדורות המשחקים</h2>
    <ReleaseGrid releases={gameReleases} />
  </section>
</BaseLayout>
