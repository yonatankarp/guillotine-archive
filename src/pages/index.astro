---
import ReleaseGrid from '../components/ReleaseGrid.astro';
import { ARCHIVE_QUOTES } from '../components/archive-quotes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredReleases, releases, supportingReleases } from '../lib/releases';
import { sitePath } from '../lib/url';

const quote = ARCHIVE_QUOTES[0]!;
---

<BaseLayout title="ארכיון גיליוטין">
  <header class="page-intro home-intro">
    <div class="home-copy">
      <p class="eyebrow">ארכיון ציבורי</p>
      <h1>ארכיון גיליוטין</h1>
      <p class="lead">
        {releases.length} מהדורות של המשחקים, הדמואים, דיסקי המעריצים והעיתונות שנשמרו מן האולפן.
        הקבצים המקוריים נשארים ב־Google Drive.
      </p>
      <figure class="found-string">
        <blockquote class="voice"><p>{quote.textHe}</p></blockquote>
        <figcaption>
          <span class="visually-hidden">שם הקובץ שממנו נלקח המשפט: </span>
          <bdi class="mono" dir="auto">{quote.sourcePath}</bdi>
        </figcaption>
      </figure>
    </div>
    <img
      class="home-character"
      src={sitePath('assets/characters/hezi.png')}
      alt="חזי מפיפוש מציץ אל הארכיון"
      width="145"
      height="365"
    />
  </header>

  <section aria-labelledby="games-heading">
    <div class="section-heading">
      <h2 id="games-heading">המשחקים</h2>
      <p>שישה משחקים שיצאו מן האולפן, מן המוקדם למאוחר.</p>
    </div>
    <ReleaseGrid releases={featuredReleases} showSummary showFacets={false} />
  </section>

  <section aria-labelledby="releases-heading">
    <div class="section-heading">
      <h2 id="releases-heading">שאר הארכיון</h2>
      <p>
        {supportingReleases.length} מהדורות נוספות: דיסקי שמע, סרטונים, עיתונות, דיסקי מעריצים
        ודמואים. כל אחת היא דיסק אחד או תיקייה אחת כפי שהגיעה. לחיפוש בכל
        <a href={sitePath('search/')}>הקבצים</a>.
      </p>
    </div>
    <ReleaseGrid releases={supportingReleases} />
  </section>
</BaseLayout>
