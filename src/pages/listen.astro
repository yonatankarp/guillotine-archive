---
import ItemRows from '../components/ItemRows.astro';
import { releaseAccent } from '../components/release-view';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalog } from '../lib/catalog';
import { releaseBySlug } from '../lib/releases';
import { categorySlug, sitePath } from '../lib/url';

/**
 * Tracks are the released audio: 169 files. The other 1,044 audio items are the voice and
 * effect clips the engines loaded, which belong to their releases rather than to a listening
 * page, so they stay in the Drive mirror.
 */
const tracks = catalog.items.filter((item) => item.kind === 'track');
const clipCount = catalog.items.filter((item) => item.kind === 'sound').length;

const byRelease = new Map<string, typeof tracks>();
for (const track of tracks) {
  const existing = byRelease.get(track.releaseSlug);
  if (existing) existing.push(track);
  else byRelease.set(track.releaseSlug, [track]);
}

const groups = [...byRelease]
  .map(([slug, items]) => ({ release: releaseBySlug.get(slug), slug, items }))
  .filter((group) => group.release !== undefined)
  .sort((left, right) => right.items.length - left.items.length);

const musicMirror = sitePath(`archive/${categorySlug('שירים')}/`);
---

<BaseLayout title="להאזין — ארכיון גיליוטין">
  <header class="page-intro">
    <p class="eyebrow">שמע</p>
    <h1>להאזין</h1>
    <p class="lead">
      {tracks.length} רצועות מן הדיסקים והמהדורות. ההשמעה באתר עוד לא קיימת: הקבצים המקוריים
      נשמרים ב־Drive, וכל רצועה נפתחת שם.
    </p>
    <p class="page-note">
      מלבד אלה יש בארכיון {clipCount} קטעי קול קצרים מתוך המשחקים עצמם, בעיקר AIFF ו־WAV.
      הם מתויקים תחת המהדורה שממנה הגיעו, ואפשר לעבור עליהם
      <a href={musicMirror}>במדף השירים</a> ובדפי המהדורות.
    </p>
  </header>

  {
    groups.map(({ release, slug, items }) => (
      <section class="room-section" style={`--accent: ${releaseAccent(release!)};`} aria-labelledby={`listen-${slug}`}>
        <h2 id={`listen-${slug}`}>
          <a href={sitePath(`release/${slug}/`)}>{release!.titleHe}</a>
        </h2>
        <ItemRows items={items} labelHe={`רצועות — ${release!.titleHe}`} showMediaNote={false} />
      </section>
    ))
  }
</BaseLayout>
