---
import ItemRows from '../components/ItemRows.astro';
import { audioUrl } from '../components/derivative';
import { releaseAccent, releaseCoverPath } from '../components/release-view';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalog } from '../lib/catalog';
import { releaseBySlug } from '../lib/releases';
import { categorySlug, sitePath } from '../lib/url';

/**
 * Tracks are the released audio: 169 files, and every one of them has an Opus derivative, so
 * this page plays. The other 1,044 audio items are the voice and effect clips the engines
 * loaded, which belong to their releases rather than to a listening page, so they stay on the
 * archive shelves.
 */
const tracks = catalog.items.filter((item) => item.kind === 'track');

const byRelease = new Map<string, typeof tracks>();
for (const track of tracks) {
  const existing = byRelease.get(track.releaseSlug);
  if (existing) existing.push(track);
  else byRelease.set(track.releaseSlug, [track]);
}

const groups = [...byRelease]
  .map(([slug, items]) => ({ release: releaseBySlug.get(slug), slug, items }))
  .filter((group) => group.release !== undefined)
  .sort((left, right) => right.items.length - left.items.length);

const musicMirror = sitePath(`archive/${categorySlug('שירים')}/`);
---

<BaseLayout title="מוזיקה — ארכיון גיליוטין">
  <header class="page-intro">
    <p class="eyebrow">ויש גם מוזיקה</p>
    <h1>מוזיקה</h1>
    <p class="lead">
      כל המוזיקה מהדיסקים ומהמהדורות מתנגנת פה, בעמוד. שיר אחד בכל פעם — ניסינו פעם שניים
      ביחד, וזה נשמע כמו תאונה.
    </p>
    <p class="page-note">
      וחוץ מזה יש פה ערימה של רעשים קצרים מתוך המשחקים עצמם. אלה לא שירים, זה מה שהמנוע פלט
      כל פעם שלחצתם על משהו. הם מתויקים אצל המהדורה שממנה באו, ואפשר לעבור עליהם{' '}
      <a href={musicMirror}>במדף השירים</a> ובדפי המהדורות.
    </p>
  </header>

  {
    groups.map(({ release, slug, items }) => (
      <section class="room-section" style={`--accent: ${releaseAccent(release!)};`} aria-labelledby={`listen-${slug}`}>
        <h2 id={`listen-${slug}`}>
          <a href={sitePath(`release/${slug}/`)}>{release!.titleHe}</a>
        </h2>
        <ItemRows
          mediaSrc={audioUrl}
          items={items}
          labelHe={`רצועות — ${release!.titleHe}`}
          releaseTitleHe={release!.titleHe}
          coverPath={releaseCoverPath(release!)}
          showMediaNote={false}
        />
      </section>
    ))
  }
</BaseLayout>
