---
import { GOOGLE_SHEET_MIME, MISSING_LIST_SOURCE_PATH } from '../catalog/missing-list';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalog, missingList } from '../lib/catalog';

/* The rows come from the generated artifact; the outward link comes from the catalog
   item, so the sheet is named in exactly one place and the link still works on a build
   where no sync has exported anything yet. */
const sourceItem =
  catalog.items.find(
    (item) => item.path === MISSING_LIST_SOURCE_PATH && item.mimeType === GOOGLE_SHEET_MIME,
  ) ?? null;

/**
 * The export is one spreadsheet, and it was rendered here as one: eleven columns wide,
 * three of them empty gutters that the sheet used as visual spacing and the page turned
 * into real cells headed "עמודה 3" for a screen reader to announce over nothing. Eleven
 * columns do not fit a phone, and at 1440px the last one was already cut off.
 *
 * What the sheet actually holds is lists, side by side: each pair of columns is a status
 * and a name, and a pair runs several lists stacked one under the other, separated by a
 * blank line with a new title under it. So the page rebuilds the lists and drops the
 * gutters. Nothing is filtered and no row is summarised — every value the export carries
 * still appears, just under the heading it was already sitting under.
 *
 * The gutters are found rather than hardcoded: a column is furniture only if it is empty
 * in the header AND in all 21 rows. A sync that fills one in would keep it.
 */
const STATUS_HEADING = 'סטטוס';

interface MissingEntry {
  statusHe: string;
  nameHe: string;
}

interface MissingSet {
  titleHe: string;
  entries: MissingEntry[];
}

const cellAt = (row: readonly string[], column: number): string => row[column] ?? '';

const usedColumns = missingList.headerHe
  .map((_, column) => column)
  .filter(
    (column) =>
      missingList.headerHe[column] !== '' ||
      missingList.rows.some((row) => cellAt(row, column) !== ''),
  );

/**
 * Pairs, walked in sheet order: a column headed סטטוס — or headed nothing at all, which is
 * how the first one arrived — takes the column after it as its names. A column that is
 * headed something else stands alone rather than being swallowed, so a reshaped sheet
 * loses nothing here; it just renders as a list without statuses.
 */
const pairs: Array<{ status: number | null; name: number }> = [];
for (let index = 0; index < usedColumns.length; index += 1) {
  const column = usedColumns[index]!;
  const header = missingList.headerHe[column] ?? '';
  const next = usedColumns[index + 1];
  if ((header === '' || header === STATUS_HEADING) && next !== undefined) {
    pairs.push({ status: column, name: next });
    index += 1;
  } else {
    pairs.push({ status: null, name: column });
  }
}

const sets: MissingSet[] = [];
for (const pair of pairs) {
  let current: MissingSet = {
    titleHe: missingList.headerHe[pair.name] ?? '',
    entries: [],
  };
  let afterBlank = false;

  for (const row of missingList.rows) {
    const statusHe = pair.status === null ? '' : cellAt(row, pair.status);
    const nameHe = cellAt(row, pair.name);

    if (statusHe === '' && nameHe === '') {
      afterBlank = true;
      continue;
    }

    /* A title inside a column, not an item: it follows a blank line AND its status cell is
       either empty or the word סטטוס repeated as a fresh header. Both signals, because one
       of them alone would eat a real row that happens to have no status recorded yet. */
    if (afterBlank && (statusHe === '' || statusHe === STATUS_HEADING)) {
      if (current.entries.length > 0) sets.push(current);
      current = { titleHe: nameHe, entries: [] };
      afterBlank = false;
      continue;
    }

    afterBlank = false;
    current.entries.push({ statusHe, nameHe });
  }

  if (current.entries.length > 0) sets.push(current);
}

/**
 * The status was a column, repeated on every list, and reading it meant reading all 63
 * cells one at a time. It is a mark at the head of the row now, learned once from the
 * legend and then recognised at a glance.
 *
 * Three marks, matched by prefix rather than by equality, because the sheet qualifies some
 * of its answers: "יש (חסר סריקה של ספר הסברים)" is still a yes, and the parenthesis is
 * still the interesting half. So a value that is not exactly the mark's own word keeps its
 * whole text on the row, verbatim — the mark says which shelf it sits on, the text says
 * what the sheet actually wrote. A value that matches no prefix at all keeps its text too
 * and simply gets no mark, the same way a list with no statuses gets no marks.
 */
const MARKS = {
  have: {
    glyph: '✅',
    labelHe: 'יש',
    glossHe: 'אצלנו, סרוק, אפשר להמשיך הלאה.',
  },
  scan: {
    glyph: '📷',
    labelHe: 'צריך לסרוק',
    glossHe: 'החפץ אצלנו. הסורק עוד לא פגש אותו.',
  },
  gone: {
    glyph: '❌',
    labelHe: 'חסר',
    glossHe: 'אין לנו. אם יש לכם, זה בדיוק הרגע.',
  },
} as const;

type MarkKey = keyof typeof MARKS;

const MARK_ORDER: readonly MarkKey[] = ['have', 'scan', 'gone'];

const markFor = (statusHe: string): MarkKey | null =>
  MARK_ORDER.find((key) => statusHe.startsWith(MARKS[key].labelHe)) ?? null;

const markCounts: Record<MarkKey, number> = { have: 0, scan: 0, gone: 0 };
let unmarkedCount = 0;
let totalRows = 0;

/* A list where nobody wrote a single status gets no mark column, the same way the empty
   gutters get no column: an always-empty cell is not a fact, it is a layout leftover. */
const rendered = sets.map((set) => ({
  titleHe: set.titleHe,
  hasStatus: set.entries.some((entry) => entry.statusHe !== ''),
  entries: set.entries.map((entry) => {
    const mark = markFor(entry.statusHe);
    totalRows += 1;
    if (mark === null) {
      if (entry.statusHe !== '') unmarkedCount += 1;
    } else {
      markCounts[mark] += 1;
    }
    return {
      nameHe: entry.nameHe,
      glyph: mark === null ? '' : MARKS[mark].glyph,
      /* Read after the name, so every row is announced the same way whether its status is
         the bare word or the sheet's own longer sentence. The comma is the pause. */
      spokenHe: mark === null ? '' : `, ${MARKS[mark].labelHe}`,
      noteHe: mark !== null && entry.statusHe === MARKS[mark].labelHe ? '' : entry.statusHe,
    };
  }),
}));
const hasRows = rendered.length > 0;

/* The page is titled "מה עוד חסר לנו" and most of it says יש. Counted rather than written
   down, so a sync that changes the sheet changes the sentence with it. */
const leftoverHe =
  unmarkedCount > 0 ? ` ועוד ${unmarkedCount} שורות שלא נכנסו לאף מגירה.` : '';
const summaryHe = `רגע לפני הרשימות, כי מגיע לכם לדעת: בגיליון ${totalRows} שורות, ומתוכן ${markCounts.have} כבר אצלנו, ${markCounts.scan} מונחות פה ומחכות לסורק, ו-${markCounts.gone} באמת חסרות.${leftoverHe} כן, דף שנקרא ״מה עוד חסר לנו״ הוא בעיקרו רשימה של מה שיש לנו. גם אנחנו שמנו לב. לא נתנצל.`;
---

<BaseLayout
  title="מה חסר — ארכיון גיליוטין"
  description="מה שעוד חסר לארכיון גיליוטין, לפי הרשימה של הארכיון עצמו."
>
  <header class="page-intro">
    <p class="eyebrow">החורים בערמה</p>
    <h1>מה עוד חסר לנו</h1>
    <p class="lead">
      אז נודה בזה כבר עכשיו, לפני שמישהו יתפוס אותנו: הארכיון לא שלם. יש דברים שפשוט אין
      לנו — קופסאות, דיסקים, גיליונות, מה שלא יהיה. אבל תשמעו, גם את זה תיעדנו! יש לנו
      רשימה מסודרת של מה שאין לנו, וזה כבר משהו. ואם במקרה אחד מהם שוכב לכם בבית בארגז —
      נו, זה בדיוק הרגע להגיד!
    </p>
  </header>

  {
    hasRows ? (
      <>
        <p class="missing-summary">{summaryHe}</p>
        <p class="missing-note">
          פירקנו את הגיליון לרשימות, בדיוק כמו שהן יושבות שם. למה לא טבלה אחת ענקית כמו
          במקור? כי בטלפון אף אחד לא הצליח לקרוא אותה.
        </p>
        <div class="missing-legend">
          <p class="missing-legend-intro">
            העמודה שנקראה סטטוס הפכה כאן לשלושה סימנים, וזה כל מה שצריך לדעת:
          </p>
          <ul>
            {MARK_ORDER.map((key) => (
              <li>
                {/* The glyph is hidden from the reading order and the word next to it is
                    the accessible name, so nobody hears an emoji described in English. */}
                <span class="missing-mark" aria-hidden="true">
                  {MARKS[key].glyph}
                </span>
                <span class="missing-legend-word">{MARKS[key].labelHe}</span>
                <span class="missing-legend-gloss">{MARKS[key].glossHe}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="missing-groups">
          {rendered.map((set) => (
            <section class="missing-group">
              <h2>{set.titleHe}</h2>
              <ul class={set.hasStatus ? undefined : 'no-marks'}>
                {set.entries.map((entry) => (
                  <li>
                    {set.hasStatus && (
                      <span class="missing-mark" aria-hidden="true">
                        {entry.glyph}
                      </span>
                    )}
                    <span class="missing-row">
                      <span class="missing-name">{entry.nameHe}</span>
                      {entry.spokenHe !== '' && entry.noteHe === '' && (
                        <span class="visually-hidden">{entry.spokenHe}</span>
                      )}
                      {entry.noteHe !== '' && <span class="missing-qualifier">{entry.noteHe}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    ) : (
      <p class="empty-archive">
        נו, איזה בושה: הרשימה עצמה לא פה כרגע. היא נמשכת מהגיליון של הארכיון בכל עדכון,
        וכאן היא עוד לא הגיעה. זה לא אומר שלא חסר כלום — זה אומר שאין לנו מה להראות לכם
        ברגע זה.
      </p>
    )
  }

  {
    sourceItem !== null && (
      <p class="missing-source">
        {hasRows ? 'הרשימות למעלה הן הגיליון של הארכיון, ותו לא. ' : 'בינתיים? '}
        <a href={sourceItem.viewUrl} target="_blank" rel="noopener noreferrer">
          הגיליון המקורי פתוח לכולם
        </a>
        , למי שרוצה לראות אותו כמו שהוא.
      </p>
    )
  }
</BaseLayout>

<style>
  /* Scoped to this page: nothing else on the site is a spreadsheet rebuilt as lists.
     Ten bordered cards were ten things competing for attention; a heading with a rule
     under it groups just as well and lets the page read as one document. */
  .missing-summary {
    max-width: 62ch;
    margin: 0 0 1.1rem;
    font-size: var(--t-m);
    line-height: 1.7;
  }

  .missing-note {
    max-width: 62ch;
    margin: 0 0 1.5rem;
    color: var(--dim);
    font-size: var(--t-s);
  }

  .missing-legend {
    margin: 0 0 clamp(2rem, 4vw, 2.75rem);
    padding: 1.1rem 0;
    border-block: 1px solid var(--stroke);
  }

  .missing-legend-intro {
    margin: 0 0 0.9rem;
    color: var(--dim);
    font-size: var(--t-s);
  }

  .missing-legend ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.9rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .missing-legend li,
  .missing-group li {
    /* The mark gets a column of its own rather than sitting loose in the line. Emoji are
       bidi-neutral and drift to the wrong end of an RTL run when they do; a grid track is
       a box, and a box cannot drift. Column 1 is the start edge, which is the right. */
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0 0.55rem;
    align-items: baseline;
  }

  .missing-mark {
    /* Named explicitly so the Hebrew text face is never asked to draw an emoji, and
       isolated as a belt to the grid track's braces. */
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: center;
    unicode-bidi: isolate;
  }

  .missing-legend-word {
    font-size: var(--t-s);
    font-weight: 700;
  }

  .missing-legend-gloss {
    grid-column: 2;
    color: var(--dim);
    font-size: var(--t-xs);
    line-height: 1.55;
  }

  .missing-groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.75rem, 3.5vw, 2.5rem) 2.5rem;
    align-items: start;
  }

  .missing-group h2 {
    margin: 0 0 0.35rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--stroke);
    font-size: var(--t-m);
  }

  .missing-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .missing-group li {
    padding-block: 0.35rem;
    font-size: var(--t-s);
    line-height: 1.55;
  }

  /* A list the sheet never gave a status to has no marks to line up, so it has no track
     for them either — an empty column is the same layout leftover as an empty gutter. */
  .missing-group ul.no-marks li {
    grid-template-columns: 1fr;
  }

  .missing-name {
    /* No min-width anywhere: the old table forced 9rem a column to keep Hebrew from
       breaking two letters to a line, and two columns of that do not fit a 320px screen. */
    overflow-wrap: anywhere;
  }

  .missing-qualifier {
    display: block;
    margin-block-start: 0.1rem;
    color: var(--dim);
    font-size: var(--t-xs);
    /* One status in the sheet is two lines with a note on the second. It was written as
       two lines and it stays two lines. */
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
