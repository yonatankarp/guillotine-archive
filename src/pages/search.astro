---
import ArchiveSearch from '../components/ArchiveSearch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="חיפוש בארכיון גיליוטין"
  description="חיפוש עברי במשחקים ובחומרי ארכיון גיליוטין"
>
  <header class="search-intro">
    <p class="eyebrow">ממהרים?</p>
    <h1>יאללה, תחפשו</h1>
    <p>
      כותבים משהו בעברית ומקבלים כל מהדורה, מסמך וקובץ שיש לו שם. ואם אתם מהאנשים המסודרים —
      אפשר גם לצמצם לפי מדף ולפי סוג. אנחנו לא נשפוט.
    </p>
  </header>
  <ArchiveSearch />
</BaseLayout>
