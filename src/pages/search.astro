---
import ArchiveSearch from '../components/ArchiveSearch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="חיפוש בארכיון גיליוטין"
  description="חיפוש עברי במשחקים ובחומרי ארכיון גיליוטין"
>
  <header class="search-intro">
    <p class="eyebrow">חיפוש</p>
    <h1>חיפוש בארכיון</h1>
    <p>
      חיפוש אחד בכל מהדורה, מסמך וקובץ שיש להם שם, תיאור או שיוך בעברית. אפשר גם לצמצם לפי מדף
      ולפי סוג קובץ, למי שמרגיש שיטתי.
    </p>
  </header>
  <ArchiveSearch />
</BaseLayout>
