---
import ArchiveSearch from '../components/ArchiveSearch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="חיפוש בארכיון גיליוטין"
  description="חיפוש עברי במשחקים ובחומרי ארכיון גיליוטין"
>
  <header class="search-intro">
    <p class="eyebrow">ממהרים?</p>
    <h1>אז בואו נחפש</h1>
    <p>
      חיפוש אחד על כל מהדורה, מסמך וקובץ שיש להם שם או תיאור בעברית. ואם אתם מהאנשים
      המסודרים, אפשר גם לצמצם לפי מדף ולפי סוג קובץ.
    </p>
  </header>
  <ArchiveSearch />
</BaseLayout>
